# RPC endpoint for deployment
RPC_URL=

# Private key for deployer account (without 0x prefix)
# Used by Hardhat "live" network (deploy:depot:live, deploy:local)
DEPLOYER_KEY=

# GCP KMS key version path (used by deploy:core:mainnet / deploy:core:sepolia)
# KMS_KEY_ARN=projects/PROJECT/locations/LOCATION/keyRings/KEYRING/cryptoKeys/KEY/cryptoKeyVersions/1

# Etherscan API key for contract verification
ETHERSCAN_KEY=

# Set to "true" to enable gas reporting during tests
REPORT_GAS=false
